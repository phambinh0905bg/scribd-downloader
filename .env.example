# Cổng chạy ứng dụng
PORT=8000
HOST=0.0.0.0

# Thời gian tự động xóa file PDF sau khi tải xong (tính bằng phút)
CLEANUP_MINUTES=30

# Chu kỳ kiểm tra dọn dẹp (tính bằng giây)
CLEANUP_INTERVAL_SECONDS=60

# Giới hạn số lượng tác vụ tải đồng thời
MAX_CONCURRENT_DOWNLOADS=3

# Độ phân giải ảnh khi render trang (1.5 - 2.0 cho độ nét HD)
DEVICE_SCALE_FACTOR=2.0

